rules_version = '2';

// Ripoti security rules.
//
// Accounts, reports, photos, staff updates, the timeline, notifications,
// Me too, confirm or reopen and announcements. Every collection not listed
// here is denied. Reviewed as a whole in Milestone 6.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    // Has clicked the link in the verification email.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Campus email domains. Keep in step with AppConfig in the app.
    function isStudentEmail(email) {
      return email.matches('.*@alustudent[.]com');
    }

    function isStaffEmail(email) {
      return email.matches('.*@alueducation[.]com');
    }

    // Approved staff. `npm run approve` puts a `staff` flag on the login
    // token (a custom claim only the Admin SDK can set). Reading the token
    // costs no document lookup, which matters because one status update
    // writes a notification per supporter and Firestore allows only 20
    // lookups per write.
    function isStaff() {
      return verified() && request.auth.token.staff == true;
    }

    function isStatus(value) {
      return value in ['submitted', 'under_review', 'in_progress', 'resolved'];
    }

    // A profile someone creates for themselves at sign up.
    // - email must be the one they signed in with
    // - role must match the email domain
    // - staff always start unapproved; nobody can approve themselves
    // - createdAt must be the server's time
    function isValidNewProfile() {
      let d = request.resource.data;
      let common = d.name is string
        && d.name.size() >= 2 && d.name.size() <= 80
        && d.email == request.auth.token.email.lower()
        && d.createdAt == request.time;
      let student = d.role == 'student'
        && isStudentEmail(d.email)
        && d.keys().hasOnly(['name', 'email', 'role', 'createdAt']);
      let staff = d.role == 'staff'
        && isStaffEmail(d.email)
        && d.staffId is string && d.staffId.size() <= 20
        && d.approved == false
        && d.keys().hasOnly(['name', 'email', 'role', 'staffId', 'approved', 'createdAt']);
      return common && (student || staff);
    }

    // ---------- users/{uid} ----------

    match /users/{uid} {
      // Your own profile, or any staff profile (needed to show who a report
      // is assigned to and to pick an assignee). Student profiles stay private.
      allow read: if isSelf(uid)
        || (verified() && resource.data.role == 'staff');

      allow create: if isSelf(uid) && isValidNewProfile();

      // People may only change their name. role, email, staffId, team and
      // approved are set at sign up or by an admin in the console.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2;

      // Only unverified accounts delete themselves ("Use a different email"
      // or the 24-hour clean-up).
      allow delete: if isSelf(uid)
        && request.auth.token.email_verified == false;
    }

    // ---------- users/{uid}/reports/{reportId} ----------
    //
    // Private link between a student and a report they sent anonymously.
    // Only the student can read it. It can only be created in the same
    // write that creates the anonymous report, and never changed.
    //
    // The anonymous report written alongside it is checked in full
    // (including that a student wrote it), so this rule only checks the link.
    match /users/{uid}/reports/{reportId} {
      allow read: if isSelf(uid) && verified();
      allow create: if isSelf(uid) && verified()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/reports/$(reportId))
        && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.anonymous == true;
      // Only "when did I last read its updates", for notifications.
      allow update: if isSelf(uid) && verified()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seenAt'])
        && request.resource.data.seenAt == request.time;
    }

    // ---------- users/{uid}/following/{reportId} ----------
    //
    // Private list of the reports a student backs ("Followed reports").
    // Written and removed only together with the supporter record.
    match /users/{uid}/following/{reportId} {
      allow read: if isSelf(uid) && verified();
      allow create: if isSelf(uid) && verified()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time
        && existsAfter(supporterPath(reportId, uid));
      allow delete: if isSelf(uid)
        && !existsAfter(supporterPath(reportId, uid));
    }

    function supporterPath(reportId, uid) {
      return /databases/$(database)/documents/reports/$(reportId)/supporters/$(uid);
    }

    // ---------- announcements/{id} ----------

    match /announcements/{announcementId} {
      allow read: if verified();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(['title', 'body', 'byName', 'createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 300
        && request.resource.data.byName is string
        && request.resource.data.createdAt == request.time;
      allow delete: if isStaff();
    }

    // ---------- users/{uid}/notifications/{id} ----------
    //
    // Written by staff when they update a report the person sent (named) or
    // backed. The owner can read them, mark them read and delete them.
    match /users/{uid}/notifications/{notificationId} {
      allow read, delete: if isSelf(uid) && verified();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
             'type', 'reportId', 'ticketNumber', 'reportTitle', 'status',
             'note', 'read', 'createdAt'])
        && request.resource.data.type in ['status', 'note']
        && request.resource.data.reportId is string
        && request.resource.data.ticketNumber is int
        && request.resource.data.reportTitle is string
        && isStatus(request.resource.data.status)
        && (request.resource.data.note == null
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 500))
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(uid) && verified()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['read'])
        && request.resource.data.read == true;
    }

    // ---------- Reports ----------

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isStudent() {
      return verified() && profile().role == 'student';
    }

    function counterPath() {
      return /databases/$(database)/documents/counters/reports;
    }

    // counters/reports holds the last ticket number handed out. It may only
    // go up by exactly one, and only in the same transaction that creates
    // the report with that number (checked on the report below).
    match /counters/reports {
      allow read: if verified();
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == 1001;
      allow update: if isStudent()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == resource.data.last + 1;
    }

    // A new report, exactly as the app writes it:
    // - by a verified student, as themselves, starting at "submitted"
    // - no assignee and no backers yet
    // - its ticket number is the one the counter moved to in this write
    // - named: it carries the reporter's id and real name
    // - anonymous: no id and no name at all, so nobody can match it to the
    //   same person's named reports; the private owner record written in
    //   the same transaction is the only link
    // - sizes match the form's limits
    function ownerRecord(uid, reportId) {
      return /databases/$(database)/documents/users/$(uid)/reports/$(reportId);
    }

    // The reporter of a report being created in this same write, named or
    // anonymous.
    function isReporterAfter(report, reportId) {
      return report.reporterId == request.auth.uid
        || existsAfter(ownerRecord(request.auth.uid, reportId));
    }

    //
    // Firestore allows 20 document lookups per transaction, and one report
    // with three photos is five writes, so each rule reads as little as it
    // can: the profile once here, nothing extra on the photos.
    function isValidNewReport(reportId) {
      let d = request.resource.data;
      let p = profile();
      return verified() && p.role == 'student'
        && d.keys().hasOnly([
          'ticketNumber', 'title', 'description', 'category', 'location',
          'urgency', 'status', 'reporterId', 'reporterName', 'anonymous',
          'photoCount', 'assignedTo', 'meTooCount', 'createdAt', 'updatedAt'])
        && d.status == 'submitted'
        && d.assignedTo == null
        && d.meTooCount == 0
        && d.ticketNumber == getAfter(counterPath()).data.last
        && d.title is string && d.title.size() >= 5 && d.title.size() <= 80
        && d.description is string
        && d.description.size() >= 1 && d.description.size() <= 300
        && d.location is string
        && d.location.size() >= 1 && d.location.size() <= 120
        && d.category in ['water', 'power', 'furniture', 'sanitation', 'safety', 'other']
        && d.urgency in ['low', 'medium', 'high']
        && d.anonymous is bool
        && (d.anonymous
              ? d.reporterId == null && d.reporterName == null
                && existsAfter(ownerRecord(request.auth.uid, reportId))
              : d.reporterId == request.auth.uid
                && d.reporterName == p.name)
        && d.photoCount is int && d.photoCount >= 0 && d.photoCount <= 3
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /reports/{reportId} {
      // Any verified user can browse every report.
      allow read: if verified();
      allow create: if isValidNewReport(reportId);

      // Staff change the status, the assignee, the after-photo flag and the
      // duplicate link, nothing else (the reporter's words, ticket number
      // and backers stay as they are). Me too and confirm or reopen add
      // student rules in Milestone 5. Reports are never deleted from the app.
      allow update: if (isStaff() && isValidStaffChange(reportId))
        || isMeTooChange(reportId)
        || isConfirmByReporter(reportId)
        || isReopenByReporter(reportId);

      // Photos are written in the same transaction as the report, by its
      // reporter, one per document ('0', '1', '2'), never more than the
      // report says it has, and each under ~780 KB (documents max out at
      // 1 MiB). They can't be changed afterwards.
      match /photos/{photoId} {
        allow read: if verified();
        allow create: if isValidAfterPhoto(photoId)
          || (verified() && isValidNewPhoto(reportId, photoId));
        // Staff may replace the after photo.
        allow update: if isValidAfterPhoto(photoId);
      }

      // The photo of the fix, added by staff when they resolve a report.
      function isValidAfterPhoto(photoId) {
        return isStaff()
          && photoId == 'after'
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 800000;
      }

      function isValidStaffChange(reportId) {
        let d = request.resource.data;
        return d.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assignedTo', 'updatedAt', 'hasAfterPhoto', 'duplicateOf'])
          && isStatus(d.status)
          && d.updatedAt == request.time
          && (d.assignedTo == null
                || (d.assignedTo.keys().hasOnly(['uid', 'name', 'team'])
                    && d.assignedTo.uid is string
                    && d.assignedTo.name is string))
          && (!('hasAfterPhoto' in d) || d.hasAfterPhoto is bool)
          && (!('duplicateOf' in d)
                || (d.duplicateOf.keys().hasOnly(['id', 'ticketNumber'])
                    && d.duplicateOf.id is string
                    && d.duplicateOf.id != reportId
                    && d.duplicateOf.ticketNumber is int));
      }

      // The reporter of this report: named (their id is on it) or
      // anonymous (they hold the private link).
      function isReporter(reportId) {
        return signedIn()
          && (resource.data.reporterId == request.auth.uid
              || exists(ownerRecord(request.auth.uid, reportId)));
      }

      // "Me too": the count moves by exactly one, in the same write that
      // adds or removes this student's supporter record. Nothing else on
      // the report may change.
      function isMeTooChange(reportId) {
        let d = request.resource.data;
        let me = supporterPath(reportId, request.auth.uid);
        return verified()
          && d.diff(resource.data).affectedKeys().hasOnly(['meTooCount'])
          && ((d.meTooCount == resource.data.meTooCount + 1
                && !exists(me) && existsAfter(me))
              || (d.meTooCount == resource.data.meTooCount - 1
                && exists(me) && !existsAfter(me)));
      }

      // "Yes, fixed": only the reporter, only on a resolved report.
      function isConfirmByReporter(reportId) {
        return verified() && isReporter(reportId)
          && resource.data.status == 'resolved'
          && resource.data.get('confirmed', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['confirmed'])
          && request.resource.data.confirmed == true;
      }

      // "Reopen": only the reporter, only a resolved report they haven't
      // confirmed, back to submitted.
      function isReopenByReporter(reportId) {
        return verified() && isReporter(reportId)
          && resource.data.status == 'resolved'
          && resource.data.get('confirmed', false) == false
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'submitted'
          && request.resource.data.updatedAt == request.time;
      }

      // Supporters ("Me too"), one per student. Staff read them to notify
      // every backer; a student can only see their own, so who backed a
      // report isn't public. Students can't back their own report, and
      // nobody can back a resolved one. The count and the private
      // "following" record change in the same write.
      match /supporters/{supporterId} {
        allow read: if isStaff() || (isSelf(supporterId) && verified());
        allow create: if isSelf(supporterId) && isStudent()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/reports/$(reportId)).data.status != 'resolved'
          && get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId != request.auth.uid
          && !exists(ownerRecord(request.auth.uid, reportId))
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.meTooCount
               == get(/databases/$(database)/documents/reports/$(reportId)).data.meTooCount + 1
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(reportId));
        allow delete: if isSelf(supporterId) && verified()
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.meTooCount
               == get(/databases/$(database)/documents/reports/$(reportId)).data.meTooCount - 1;
      }

      // The report it belongs to is checked in full in the same write, so a
      // photo only needs to belong to it and fit its photo count.
      function isValidNewPhoto(reportId, photoId) {
        let report = getAfter(/databases/$(database)/documents/reports/$(reportId)).data;
        return photoId in ['0', '1', '2']
          && !exists(/databases/$(database)/documents/reports/$(reportId))
          && int(photoId) < report.photoCount
          && isReporterAfter(report, reportId)
          && request.resource.data.keys().hasOnly(['index', 'data'])
          && request.resource.data.index == int(photoId)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 800000;
      }

      // The progress timeline. One entry per staff update, never changed.
      match /updates/{updateId} {
        allow read: if verified();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly([
               'status', 'previousStatus', 'note', 'byUid', 'byName', 'byTeam',
               'createdAt'])
          && isStatus(request.resource.data.status)
          && (!('previousStatus' in request.resource.data)
                || isStatus(request.resource.data.previousStatus))
          && (request.resource.data.note == null
                || (request.resource.data.note is string
                    && request.resource.data.note.size() <= 500))
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.byName is string
          && request.resource.data.createdAt == request.time
        // The reporter's "Reopen" entry, in the same write as the reopen.
        // It names "Reporter" and carries no user id, so reopening an
        // anonymous report doesn't reveal who sent it.
        || (verified()
          && isReporterOf(reportId)
          && request.resource.data.keys().hasOnly([
               'status', 'previousStatus', 'note', 'byUid', 'byName',
               'createdAt'])
          && request.resource.data.status == 'submitted'
          && request.resource.data.previousStatus == 'resolved'
          && request.resource.data.note is string
          && request.resource.data.note.size() >= 5
          && request.resource.data.note.size() <= 320
          && request.resource.data.byUid == ''
          && request.resource.data.byName == 'Reporter'
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/reports/$(reportId)).data.status == 'resolved'
          && getAfter(/databases/$(database)/documents/reports/$(reportId)).data.status == 'submitted');
      }

      // Same as isReporter, for rules on documents inside the report.
      function isReporterOf(reportId) {
        return get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
          || exists(ownerRecord(request.auth.uid, reportId));
      }
    }
  }
}
